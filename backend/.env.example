# ── ClearVault backend environment ─────────────────────────────────────
# 1) Copy this file to .env   →   cp .env.example .env
# 2) Fill in values (never commit your real .env — it's gitignored)

# ─────────── Google Sign-In (required for "Continue with Google") ──────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Must EXACTLY match an "Authorized redirect URI" on the OAuth client:
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Where the backend lives/is reachable (used to build the default callback URL)
BACKEND_URL=http://localhost:4000
# Where the React app lives (OAuth results redirect back here)
FRONTEND_URL=http://localhost:5173

# ─────────── Database (optional — empty = local JSON demo store) ───────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────── Signing secret ────────────────────────────────────────────
# Signs certificates + sessions. Set once in production; never change or
# previously issued certificates will stop verifying.
SIGNING_SECRET=
